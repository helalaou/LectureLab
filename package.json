{
  "name": "lecturelab",
  "version": "0.1.0",
  "private": true,
  "description": "Record or upload lectures and turn them into study notes, flashcards, quizzes, a study podcast and an AI tutor grounded in your course material.",
  "keywords": [
    "education",
    "study",
    "lecture",
    "transcription",
    "flashcards",
    "spaced-repetition",
    "openai",
    "firebase",
    "netlify",
    "react"
  ],
  "homepage": "https://github.com/helalaou/lecturelab#readme",
  "bugs": {
    "url": "https://github.com/helalaou/lecturelab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helalaou/lecturelab.git"
  },
  "license": "MIT",
  "author": "Hamza El Alaoui",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy:rules": "npx firebase-tools deploy --only firestore"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.8",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "jose": "^6.2.15",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^6.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "netlify-cli": "^27.16.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3"
  }
}
