# Copy to .env for local development. On Netlify, set the same variables under
# Site configuration → Environment variables. See README → Configuration.

# --- Firebase web app (Firebase console → Project settings → Your apps → Web) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# --- Server only: never exposed to the browser ---

# Optional. Shared OpenAI key used only by the accounts in ALLOWED_EMAILS.
# Leave empty if every user should bring their own key.
OPENAI_API_KEY=

# Optional. Comma-separated emails allowed to use OPENAI_API_KEY.
ALLOWED_EMAILS=

# Required. Encrypts personal API keys at rest and signs audio playback links.
# Generate with: openssl rand -base64 32   (do not change it after launch)
KEY_ENCRYPTION_SECRET=
