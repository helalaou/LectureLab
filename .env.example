# ---------- Firebase web app config (Firebase Console → Project settings → Your apps) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ---------- Netlify Functions (server only, never exposed) ----------
# Shared OpenAI key, used only for the emails listed in ALLOWED_EMAILS
OPENAI_API_KEY=sk-...
ALLOWED_EMAILS=you@gmail.com, neighbour@gmail.com

# 32+ random characters; encrypts personal API keys and signs audio links.
# Generate one with:  openssl rand -base64 32
KEY_ENCRYPTION_SECRET=change-me
