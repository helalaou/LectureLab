rules_version = '2';

// Each signed-in user can read and write only the documents under users/{their uid}.
// Server functions call Firestore with the user's own ID token, so these rules
// apply to every request, from the browser and from the API alike.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
