rules_version = '2';
// LectureLab — paste this into Firebase Console → Firestore Database → Rules → Publish.
// Every user can read and write only their own data under users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
